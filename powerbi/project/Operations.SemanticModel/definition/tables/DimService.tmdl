table DimService
	column service_key
		dataType: int64
		summarizeBy: none
		sourceColumn: service_key
		isHidden

	column service_name
		dataType: string
		summarizeBy: none
		sourceColumn: service_name

	column agency
		dataType: string
		summarizeBy: none
		sourceColumn: agency

	partition DimService = m
		mode: import
		source =
			let
			    Packed = Text.Combine({""}),
			    Source = Csv.Document(Binary.Decompress(Binary.FromText(Packed, BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
			    Typed = Table.TransformColumnTypes(Blanks, {{"service_key", Int64.Type}, {"service_name", type text}, {"agency", type text}}, "en-CA")
			in
			    Typed
