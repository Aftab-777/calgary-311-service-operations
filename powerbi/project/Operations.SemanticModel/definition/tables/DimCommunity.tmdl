table DimCommunity
	column community_key
		dataType: int64
		summarizeBy: none
		sourceColumn: community_key
		isHidden

	column community_code
		dataType: string
		summarizeBy: none
		sourceColumn: community_code

	column community
		dataType: string
		summarizeBy: none
		sourceColumn: community

	partition DimCommunity = m
		mode: import
		source =
			let
			    Packed = Text.Combine({""}),
			    Source = Csv.Document(Binary.Decompress(Binary.FromText(Packed, BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
			    Typed = Table.TransformColumnTypes(Blanks, {{"community_key", Int64.Type}, {"community_code", type text}, {"community", type text}}, "en-CA")
			in
			    Typed
