table FactRequests
	measure 'Source Records' = COUNTROWS ( FactRequests )
		formatString: "#,0"

	measure 'Duplicate Records' = CALCULATE ( COUNTROWS ( FactRequests ), FactRequests[duplicate] = 1 )
		formatString: "#,0"

	measure 'Requests' = CALCULATE ( COUNTROWS ( FactRequests ), FactRequests[duplicate] = 0 )
		formatString: "#,0"

	measure 'Open Requests' = COALESCE ( CALCULATE ( COUNTROWS ( FactRequests ), FactRequests[is_open] = 1 ), 0 )
		formatString: "#,0"

	measure 'Closed Requests' = COALESCE ( CALCULATE ( COUNTROWS ( FactRequests ), FactRequests[is_closed] = 1 ), 0 )
		formatString: "#,0"

	measure 'Valid Closure Sample' = COUNT ( FactRequests[closure_days] )
		formatString: "#,0"

	measure 'Median Closure Days' = MEDIAN ( FactRequests[closure_days] )
		formatString: "0.0"

	measure 'P90 Closure Days' = PERCENTILEX.INC ( FILTER ( FactRequests, NOT ISBLANK ( FactRequests[closure_days] ) ), FactRequests[closure_days], 0.9 )
		formatString: "0.0"

	measure 'Median Open Age Days' = MEDIAN ( FactRequests[age_days] )
		formatString: "0.0"

	measure 'Open 30 Plus Days' = COALESCE ( CALCULATE ( COUNTROWS ( FactRequests ), FactRequests[is_open] = 1, FactRequests[age_days] >= 30 ), 0 )
		formatString: "#,0"

	measure 'Missing Closure Dates' = SUM ( FactRequests[missing_closed] )
		formatString: "#,0"

	measure 'Invalid Closure Dates' = SUM ( FactRequests[invalid_closed] )
		formatString: "#,0"

	measure 'Open With Closure Date' = SUM ( FactRequests[open_with_closed] )
		formatString: "#,0"

	measure 'Unknown Status Records' = SUM ( FactRequests[unknown_status] )
		formatString: "#,0"

	column request_id
		dataType: string
		summarizeBy: none
		sourceColumn: request_id

	column requested_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: requested_date
		formatString: "yyyy-MM-dd"
		annotation UnderlyingDateTimeDataType = Date

	column closed_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: closed_date
		formatString: "yyyy-MM-dd"
		annotation UnderlyingDateTimeDataType = Date

	column service_key
		dataType: int64
		summarizeBy: none
		sourceColumn: service_key
		isHidden

	column channel_key
		dataType: int64
		summarizeBy: none
		sourceColumn: channel_key
		isHidden

	column community_key
		dataType: int64
		summarizeBy: none
		sourceColumn: community_key
		isHidden

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column duplicate
		dataType: int64
		summarizeBy: none
		sourceColumn: duplicate
		isHidden

	column is_open
		dataType: int64
		summarizeBy: none
		sourceColumn: is_open
		isHidden

	column is_closed
		dataType: int64
		summarizeBy: none
		sourceColumn: is_closed
		isHidden

	column closure_days
		dataType: int64
		summarizeBy: none
		sourceColumn: closure_days
		isHidden

	column age_days
		dataType: int64
		summarizeBy: none
		sourceColumn: age_days
		isHidden

	column invalid_closed
		dataType: int64
		summarizeBy: none
		sourceColumn: invalid_closed
		isHidden

	column missing_closed
		dataType: int64
		summarizeBy: none
		sourceColumn: missing_closed
		isHidden

	column invalid_requested
		dataType: int64
		summarizeBy: none
		sourceColumn: invalid_requested
		isHidden

	column unknown_status
		dataType: int64
		summarizeBy: none
		sourceColumn: unknown_status
		isHidden

	column open_with_closed
		dataType: int64
		summarizeBy: none
		sourceColumn: open_with_closed
		isHidden

	partition FactRequests = m
		mode: import
		source =
			let
			    Packed = Text.Combine({"","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","",""}),
			    Source = Csv.Document(Binary.Decompress(Binary.FromText(Packed, BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
			    Typed = Table.TransformColumnTypes(Blanks, {{"request_id", type text}, {"requested_date", type date}, {"closed_date", type date}, {"service_key", Int64.Type}, {"channel_key", Int64.Type}, {"community_key", Int64.Type}, {"status", type text}, {"duplicate", Int64.Type}, {"is_open", Int64.Type}, {"is_closed", Int64.Type}, {"closure_days", Int64.Type}, {"age_days", Int64.Type}, {"invalid_closed", Int64.Type}, {"missing_closed", Int64.Type}, {"invalid_requested", Int64.Type}, {"unknown_status", Int64.Type}, {"open_with_closed", Int64.Type}}, "en-CA")
			in
			    Typed
