table DimDate
	column date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date
		formatString: "yyyy-MM-dd"
		annotation UnderlyingDateTimeDataType = Date

	column month
		dataType: string
		summarizeBy: none
		sourceColumn: month

	column weekday
		dataType: string
		summarizeBy: none
		sourceColumn: weekday
		sortByColumn: weekday_order

	column weekday_order
		dataType: int64
		summarizeBy: none
		sourceColumn: weekday_order

	partition DimDate = m
		mode: import
		source =
			let
			    Packed = Text.Combine({""}),
			    Source = Csv.Document(Binary.Decompress(Binary.FromText(Packed, BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
			    Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"month", type text}, {"weekday", type text}, {"weekday_order", Int64.Type}}, "en-CA")
			in
			    Typed
