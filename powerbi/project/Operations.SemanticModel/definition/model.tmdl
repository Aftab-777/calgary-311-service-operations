model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	discourageImplicitMeasures

annotation __PBI_TimeIntelligenceEnabled = 0
annotation PBI_QueryOrder = ["FactRequests", "DimService", "DimChannel", "DimCommunity", "DimDate", "Snapshot"]

ref table FactRequests
ref table DimService
ref table DimChannel
ref table DimCommunity
ref table DimDate
ref table Snapshot
